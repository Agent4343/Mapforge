# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./mapforge.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/mapforge

# Auth — REQUIRED in production (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=

# Stripe — REQUIRED for payments in production (leave empty for dev mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# File storage ("local" for dev, "s3" for production)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# S3 (for production — Supabase Storage, AWS S3, etc.)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# CORS
FRONTEND_URL=http://localhost:3000

# Admin — comma-separated list of admin email addresses
ADMIN_EMAILS=

# AI Description Generation (Claude API — optional)
ANTHROPIC_API_KEY=

# Redis (optional caching layer)
REDIS_URL=

# Production flag (Railway sets RAILWAY_ENVIRONMENT automatically)
# PRODUCTION=true

# Railway auto-sets these:
# PORT=8000
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
