# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./mapforge.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/mapforge

# Auth
SECRET_KEY=change-this-to-a-random-secret-in-production

# Stripe (leave empty for mock payments in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# File storage ("local" for dev, "s3" for production)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# S3 (for production — Supabase Storage, AWS S3, etc.)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Etsy shop URL (shown to customers as the purchase link)
ETSY_SHOP_URL=https://mapforgedesign.etsy.com

# Etsy API (register at https://www.etsy.com/developers)
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_REDIRECT_URI=http://localhost:8000/api/v1/etsy/callback
ETSY_WEBHOOK_SECRET=

# CORS
FRONTEND_URL=http://localhost:3000

# Railway auto-sets these:
# PORT=8000
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
